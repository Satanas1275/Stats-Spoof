{
  "schemaVersion": 1,
  "id": "statsspoof",
  "version": "${version}",
  "name": "StatsSpoof",
  "description": "Remplace uniquement les valeurs affichees sur l'ecran des statistiques (aucune modification du fichier de sauvegarde).",
  "authors": ["Satanas1275 / Rocknite Studio"],
  "contact": {},
  "license": "MIT",

  "environment": "client",
  "entrypoints": {
    "client": [
      "com.rocknitestudio.statsspoof.StatsSpoofClient"
    ]
  },

  "mixins": [
    "statsspoof.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "26.2",
    "java": ">=25"
  }
}
